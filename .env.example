# ORGΛNON — the Ask console's AI phrasing is OPTIONAL + BYOK (X-BYOK). Copy this to `.env` and set ONE key.
# Keys are server-side env-only, NEVER committed / bundled / logged. With NO key, the console runs the deterministic mode.
# Priority order (the first present wins): Google AI Studio (the free default) → Gemini → OpenAI → Anthropic → OpenAI-compatible.

# Groq (llama-3.1-8b-instant) — free-tier friendly, checked FIRST; a rate-limit queue + retry/backoff avoids 429s.
# https://console.groq.com/keys  (optional: GROQ_MODEL to override the model)
GROQ_API_KEY=
# GROQ_MODEL=llama-3.1-8b-instant

# Google AI Studio (Gemini) — the pinned default — https://aistudio.google.com/app/apikey
GOOGLE_AI_STUDIO_KEY=

# BYOK alternatives (set at most one)
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=          # required if using the Anthropic key — set your provider's model id (no default is shipped)
# OPENAI_COMPATIBLE_BASE_URL=
# OPENAI_COMPATIBLE_API_KEY=
# OPENAI_COMPATIBLE_MODEL=
